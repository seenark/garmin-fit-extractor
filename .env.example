# PostgreSQL runtime configuration. Replace every placeholder before deployment.
POSTGRES_DB=garmin_fit_extractor
POSTGRES_USER=garmin_fit_extractor
POSTGRES_PASSWORD=replace-with-a-generated-url-safe-password
DATABASE_URL=postgresql://garmin_fit_extractor:replace-with-a-generated-url-safe-password@postgres:5432/garmin_fit_extractor

# Comma-separated verified Google email addresses. Empty means deny-all.
ADMIN_EMAILS=

# Browser-visible HTTP(S) origin used to protect admin mutations. Empty denies them.
GARMIN_FIT_APP_ORIGIN=

GARMIN_FIT_BIND=0.0.0.0:3000
GARMIN_FIT_STATIC_DIR=/app/public
GARMIN_FIT_GOOGLE_CLIENT_ID=
GARMIN_FIT_GOOGLE_CLIENT_SECRET=
GARMIN_FIT_GOOGLE_REDIRECT_URI=
GARMIN_FIT_CHATGPT_CLIENT_ID=
GARMIN_FIT_CHATGPT_CLIENT_SECRET=
GARMIN_FIT_CHATGPT_REDIRECT_URI=
RUST_LOG=info
