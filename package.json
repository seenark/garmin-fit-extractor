{
  "name": "garmin-fit-extractor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @garmin-fit-extractor/web dev & cargo run -p garmin-fit-extractor-api",
    "build": "bun --no-env-file run --filter '*' build && cargo build --locked --workspace",
    "test": "bun --no-env-file scripts/e2e.ts --test",
    "test:e2e": "bun --no-env-file scripts/e2e.ts",
    "check": "bun --no-env-file run --filter '*' check && cargo fmt --check --all && cargo clippy --locked --workspace --all-targets -- -D warnings"
  },
  "packageManager": "bun@1.3.14"
}
